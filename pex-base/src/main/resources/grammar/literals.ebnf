grammar pex-literals;

// All literal types supported by the PEX expression language

literal ::= float-literal
           | hex-literal
           | bin-literal
           | oct-literal
           | int-literal
           | bool-literal
           | string-literal
           | null-literal ;

// Numeric literals
int-literal ::= /[0-9]+/ ;

float-literal ::= /[0-9]+\.[0-9]*([eE][+-]?[0-9]+)?/
                 | /\.[0-9]+([eE][+-]?[0-9]+)?/
                 | /[0-9]+[eE][+-]?[0-9]+/ ;

// Radix literals
hex-literal ::= /0[xX][0-9a-fA-F]+/ ;
bin-literal ::= /0[bB][01]+/ ;
oct-literal ::= /0[oO][0-7]+/ ;

// Boolean
bool-literal ::= 'true' | 'false' ;

// String
string-literal ::= /\"[^\"]*\"/ | /\'[^\']*\'/ ;

// Null
null-literal ::= 'null' ;

// Identifier
identifier ::= /[a-zA-Z_][a-zA-Z0-9_]*/ ;
