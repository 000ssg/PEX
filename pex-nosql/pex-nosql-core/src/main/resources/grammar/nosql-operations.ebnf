grammar nosql-operations;

// NoSQL CRUD and Aggregation Operation Grammar
// Covers Collection CRUD, Update operators, Aggregation pipeline stages

// ─── CRUD Operations ─────────────────────────────────────────────────────────

crud-operation ::= insert-one
                 | insert-many
                 | find
                 | find-one
                 | update-one
                 | update-many
                 | replace-one
                 | delete-one
                 | delete-many
                 | count
                 | distinct
                 | aggregate ;

insert-one  ::= 'insertOne'  '(' document ')' ;
insert-many ::= 'insertMany' '(' '[' document (',' document)* ']' ')' ;

find        ::= 'find'    '(' filter? ')' find-modifier* ;
find-one    ::= 'findOne' '(' filter? ')' ;

find-modifier ::= sort-modifier | limit-modifier | skip-modifier | project-modifier ;
sort-modifier    ::= '.sort'    '(' sort-spec ')' ;
limit-modifier   ::= '.limit'   '(' number ')' ;
skip-modifier    ::= '.skip'    '(' number ')' ;
project-modifier ::= '.project' '(' projection ')' ;

update-one  ::= 'updateOne'  '(' filter ',' update-doc ')' ;
update-many ::= 'updateMany' '(' filter ',' update-doc ')' ;
replace-one ::= 'replaceOne' '(' filter ',' document ')' ;

delete-one  ::= 'deleteOne'  '(' filter ')' ;
delete-many ::= 'deleteMany' '(' filter ')' ;

count    ::= 'count'    '(' filter? ')' ;
distinct ::= 'distinct' '(' field-path (',' filter)? ')' ;
aggregate ::= 'aggregate' '(' '[' pipeline-stage (',' pipeline-stage)* ']' ')' ;

// ─── Update Document ─────────────────────────────────────────────────────────

update-doc ::= '{' update-operator (',' update-operator)* '}' ;

update-operator ::= set-op | unset-op | inc-op | push-op | pull-op | add-to-set-op | rename-op ;

set-op        ::= '$set'       ':' '{' field-path ':' value (',' field-path ':' value)* '}' ;
unset-op      ::= '$unset'     ':' '{' field-path ':' '' (',' field-path ':' '')* '}' ;
inc-op        ::= '$inc'       ':' '{' field-path ':' number (',' field-path ':' number)* '}' ;
push-op       ::= '$push'      ':' '{' field-path ':' value (',' field-path ':' value)* '}' ;
pull-op       ::= '$pull'      ':' '{' field-path ':' value (',' field-path ':' value)* '}' ;
add-to-set-op ::= '$addToSet'  ':' '{' field-path ':' value (',' field-path ':' value)* '}' ;
rename-op     ::= '$rename'    ':' '{' field-path ':' string (',' field-path ':' string)* '}' ;

// ─── Sort / Projection ───────────────────────────────────────────────────────

sort-spec   ::= '{' sort-entry (',' sort-entry)* '}' ;
sort-entry  ::= field-path ':' ('1' | '-1') ;         // 1 = ASC, -1 = DESC

projection  ::= '{' proj-entry (',' proj-entry)* '}' ;
proj-entry  ::= field-path ':' ('0' | '1') ;          // 1 = include, 0 = exclude

// ─── Aggregation Pipeline Stages ─────────────────────────────────────────────

pipeline-stage ::= match-stage
                 | project-stage
                 | sort-stage
                 | limit-stage
                 | skip-stage
                 | group-stage
                 | unwind-stage
                 | lookup-stage
                 | add-fields-stage
                 | count-stage ;

match-stage      ::= '{' '$match'     ':' filter '}' ;
project-stage    ::= '{' '$project'   ':' projection '}' ;
sort-stage       ::= '{' '$sort'      ':' sort-spec '}' ;
limit-stage      ::= '{' '$limit'     ':' number '}' ;
skip-stage       ::= '{' '$skip'      ':' number '}' ;
count-stage      ::= '{' '$count'     ':' string '}' ;

unwind-stage     ::= '{' '$unwind'    ':' field-ref '}' ;
field-ref        ::= '"$' identifier '"' ;

group-stage ::= '{' '$group' ':' '{' '_id' ':' group-id-expr
                (',' accumulator-field)* '}' '}' ;
group-id-expr    ::= field-ref | string | 'null' ;
accumulator-field ::= string ':' '{' accumulator-op ':' (field-ref | number) '}' ;
accumulator-op   ::= '$sum' | '$avg' | '$min' | '$max' | '$count' | '$push' | '$first' | '$last' ;

add-fields-stage ::= '{' '$addFields' ':' '{' string ':' add-fields-expr
                     (',' string ':' add-fields-expr)* '}' '}' ;
add-fields-expr  ::= field-ref | concat-expr | arithmetic-expr | value ;
concat-expr      ::= '{' '$concat' ':' '[' (field-ref | string) (',' (field-ref | string))* ']' '}' ;
arithmetic-expr  ::= '{' ('$multiply' | '$subtract' | '$add' | '$divide')
                     ':' '[' (field-ref | number) ',' (field-ref | number) ']' '}' ;

lookup-stage ::= '{' '$lookup' ':' '{'
                 '"from"'         ':' string ','
                 '"localField"'   ':' string ','
                 '"foreignField"' ':' string ','
                 '"as"'           ':' string
                 '}' '}' ;

// ─── Common ──────────────────────────────────────────────────────────────────

filter      ::= document ;    // see nosql-query.ebnf for full detail
document    ::= '{' (string ':' value (',' string ':' value)*)? '}' ;
field-path  ::= identifier ('.' identifier)* ;
value       ::= string | number | boolean | 'null' | array | document ;
array       ::= '[' (value (',' value)*)? ']' ;
boolean     ::= 'true' | 'false' ;
string      ::= '"' /[^"\\]*/ '"' ;
number      ::= /-?[0-9]+(\.[0-9]+)?([eE][+-]?[0-9]+)?/ ;
identifier  ::= /[a-zA-Z_$][a-zA-Z0-9_$]*/ ;
