grammar nosql-query;

// NoSQL Query Filter and Update Operator Grammar
// Models the filter/update document DSL used by InMemoryCollection / QueryEvaluator / UpdateEvaluator

// ─── Filter Document ──────────────────────────────────────────────────────────

filter ::= '{' filter-entry (',' filter-entry)* '}'
         | '{' '}' ;                                      // empty — matches all

filter-entry ::= field-condition | logical-operator ;

// Plain field condition: {"field": value} or {"field": {$op: value}}
field-condition ::= field-path ':' (value | operator-doc) ;

// Top-level logical operators applied to the whole document
logical-operator ::= '$and' ':' '[' filter (',' filter)* ']'
                   | '$or'  ':' '[' filter (',' filter)* ']'
                   | '$not' ':' filter ;

// Operator document: one or more $ operators on a field
operator-doc ::= '{' field-operator (',' field-operator)* '}' ;

field-operator ::= comparison-op | membership-op | existence-op | pattern-op ;

// ─── Comparison Operators ─────────────────────────────────────────────────────

comparison-op ::= '$eq'  ':' value       // equal
                | '$ne'  ':' value       // not equal
                | '$gt'  ':' value       // greater than
                | '$gte' ':' value       // greater than or equal
                | '$lt'  ':' value       // less than
                | '$lte' ':' value ;     // less than or equal

// ─── Membership Operators ─────────────────────────────────────────────────────

membership-op ::= '$in'  ':' '[' value (',' value)* ']'   // field in list
                | '$nin' ':' '[' value (',' value)* ']' ;  // field not in list

// ─── Existence / Pattern Operators ───────────────────────────────────────────

existence-op ::= '$exists' ':' boolean ;
pattern-op   ::= '$regex'  ':' string ;

// ─── Field Path (dot notation for nested documents) ──────────────────────────

field-path ::= identifier ('.' identifier)* ;

// ─── Scalars ─────────────────────────────────────────────────────────────────

value   ::= string | number | boolean | 'null' | array | document ;
array   ::= '[' (value (',' value)*)? ']' ;
document ::= '{' (string ':' value (',' string ':' value)*)? '}' ;
boolean ::= 'true' | 'false' ;
string  ::= '"' /[^"\\]*/ '"' ;
number  ::= /-?[0-9]+(\.[0-9]+)?([eE][+-]?[0-9]+)?/ ;
identifier ::= /[a-zA-Z_$][a-zA-Z0-9_$]*/ ;
